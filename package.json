{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "generate": "prisma generate --config apps/api/prisma.config.ts",
    "migrate": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "build": "npm run generate && npm run build -w @hub/api && npm run build -w @hub/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p apps/desktop/tsconfig.json --noEmit",
    "lint": "eslint apps packages tests",
    "test:unit": "node scripts/prepare-rnnoise.mjs && tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts,mjs}\"",
    "desktop:build": "npm run build -w @hub/web && npm run build -w @hub/desktop",
    "desktop:dev": "npm run desktop:build && npm run start -w @hub/desktop",
    "desktop:package": "node scripts/check-windows.mjs && npm run desktop:build && npm run package -w @hub/desktop",
    "desktop:install-runtime": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/platform-socket.io": "12.0.3",
    "@nestjs/websockets": "12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "http-proxy-middleware": "3.0.7",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
