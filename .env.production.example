APP_NAME=Hub
APP_ENV=production
APP_URL=https://hub.mrloic.ru
VOICE_ENABLED=true
PUBLIC_IPV4=<PUBLIC_IPV4>
POSTGRES_VOLUME=hub_postgres-data
POSTGRES_PASSWORD=<COPY_EXISTING_LOCAL_DATABASE_PASSWORD>
APP_SECRET=<COPY_EXISTING_APP_SECRET>
PROXY_SECRET=<GENERATE_RANDOM_48_BYTES_HEX>
LIVEKIT_API_KEY=<COPY_EXISTING_LIVEKIT_KEY>
LIVEKIT_API_SECRET=<COPY_EXISTING_LIVEKIT_SECRET>
