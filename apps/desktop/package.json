{
  "name": "@hub/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Hub \u2014 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0442\u0435\u043a\u0441\u0442 \u0438 \u0433\u043e\u043b\u043e\u0441",
  "author": "Hub",
  "main": "dist/apps/desktop/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "package": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "koffi": "3.3.0"
  },
  "build": {
    "appId": "ru.mrloic.hub",
    "productName": "Hub",
    "artifactName": "Hub-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../third_party/rnnoise",
        "to": "licenses/rnnoise"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/hub.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
